# ---------- ঐচ্ছিক: ফোর্স-জয়েন ও ক্যাপশন ----------
# ইউজারদের এই চ্যানেলে জয়েন করতে হবে (যেমন @mychannel)। খালি = বন্ধ।
FORCE_CHANNEL= @EdusTech
# প্রতিটি ফাইলের সাথে যে ক্যাপশন যাবে
CUSTOM_CAPTION=

# ---------- পেমেন্ট (আপনার নাম্বারগুলো দিন) ----------
CURRENCY=৳
PAY_BKASH= @FreeHoster 
PAY_NAGAD= 01711223344
PAY_ROCKET=
PAY_UPI=
PAY_CRYPTO=
# পেমেন্ট স্ক্রিনে অতিরিক্ত নির্দেশনা (বাংলায় লিখতে পারেন)
PAY_NOTE=

# ---------- সাপোর্ট / কন্টাক্ট ----------
# ইউজাররা "📞 অ্যাডমিন কন্টাক্ট" চাপলে যে তথ্য দেখবে
SUPPORT_CONTACT=
SUPPORT_NOTE=
# একই ইউজার কত সেকেন্ড পর পর নতুন টিকেট খুলতে পারবে
TICKET_COOLDOWN=60

# ---------- ট্রায়াল ও অটো-অ্যাপ্রুভাল ----------
# প্রিমিয়াম স্টোরে ফ্রি ট্রায়াল কত ঘণ্টা (0 দিলে ট্রায়াল বন্ধ)
TRIAL_HOURS=24
# দাম ০ হলে অর্ডার নিজে থেকেই অ্যাপ্রুভ হবে কি না
AUTO_APPROVE_ZERO=true

# ---------- আচরণ ----------
# আপনার টাইমজোন (বাংলাদেশ = 6.0)। সার্ভারের টাইমজোন যা-ই হোক, ড্রিপ/রিমাইন্ডার আপনার সময়ে চলবে।
TZ_OFFSET=6.0
CONTENT_PAGE_SIZE=12
SEARCH_RESULT_LIMIT=12
FORCE_JOIN_CACHE_SECONDS=600
JIT_TIMEOUT_SECONDS=10
CLEANUP_JIT_COPY=true
BROADCAST_DELAY=0.35
DRIP_SEND_DELAY=0.5
FLOOD_SAFETY_MAX=900

# ---------- ইনলাইন মোড ----------
# @BotFather → /setinline দিয়ে ইনলাইন চালু করে এখানে true রাখুন।
INLINE_ENABLED=true
INLINE_RESULTS=20

# ---------- ভাষা ----------
# ডিফল্ট ভাষা: bn (বাংলা) বা en (English)
DEFAULT_LANG=bn

# ---------- ওয়েব ড্যাশবোর্ড (ঐচ্ছিক) ----------
# চালু করতে: WEB_ENABLED=true এবং WEB_PASS দিতে ভুলবেন না
WEB_ENABLED=false
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_USER=admin
WEB_PASS=
WEB_SECRET=

# ---------- পেজ সাইজ (বাটনের সংখ্যা) ----------
GROUPS_PAGE_SIZE=8
CONTENT_PAGE_SIZE=12
USERS_PAGE_SIZE=10
MANAGE_PAGE_SIZE=10

# ---------- ফাইল পাথ (ডিফল্ট ঠিক আছে, দরকার হলে বদলান) ----------
# DB_FILE=bot_data.sqlite3          # ডেটাবেস ফাইল
# LEGACY_DB_FILE=bot_db.json        # পুরোনো JSON (প্রথম চালুতে অটো-ইমপোর্ট)
# BACKUP_DIR=backups                # দৈনিক ব্যাকআপ ফোল্ডার
# LOG_FILE=logs/bot.log             # লগ ফাইল
# SESSION_STATE_FILE=bot_master.session
# প্রতিদিন কয়টার সময় (আপনার TZ) অটো-ব্যাকআপ হবে
BACKUP_HOUR=4
# সর্বোচ্চ কতটি ব্যাকআপ রাখবেন
KEEP_BACKUPS=7
